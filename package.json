{
  "name": "shoes_store_client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "npm run dev",
    "dev:demo": "webpack serve --mode development --env demo --port 5181",
    "build": "webpack --mode production && node scripts/copy-public.cjs",
    "build:demo": "node scripts/build-demo.cjs",
    "preview": "node scripts/preview.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "check:architecture": "node scripts/check-architecture.cjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm run check:architecture && npm run typecheck && npm test",
    "format": "prettier --write src scripts *.cjs *.js *.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "ts-jest": "29.2.5",
    "jest-environment-jsdom": "29.7.0",
    "html-webpack-plugin": "^5.6.0",
    "dotenv": "^16.5.0",
    "style-loader": "^3.3.4",
    "css-loader": "^6.10.0",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2"
  },
  "description": "STEP — a streetwear shop pet project with an interactive standalone demo",
  "engines": {
    "node": ">=22 <25"
  }
}
